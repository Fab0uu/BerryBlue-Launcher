{
  "name": "eidolyth",
  "version": "2.0.4",
  "productName": "Eidolyth",
  "description": "Eidolyth Minecraft Launcher",
  "author": "Daniel Scalzi (https://github.com/dscalzi/), Fabrice Lozac'h (https://github.com/Fab0uu)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Fab0uu/Eidolyth-Launcher",
  "bugs": {
    "url": "https://github.com/Fab0uu/Eidolyth-Launcher/issues"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "dist": "electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l -c.productName=Eidolyth",
    "lint": "eslint --config .eslintrc.json .",
    "test:linux": "node --test tests/linux/*.test.js",
    "verify:linux-artifacts": "node scripts/verify-linux-artifacts.js"
  },
  "engines": {
    "node": "20.x.x"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "adm-zip": "^0.5.12",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.1.8",
    "fs-extra": "^11.1.1",
    "github-syntax-dark": "^0.5.0",
    "got": "^11.8.5",
    "helios-core": "~2.2.1",
    "helios-distribution-types": "^1.3.0",
    "jquery": "^3.7.1",
    "lodash.merge": "^4.6.2",
    "semver": "^7.6.0",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fab0uu/Eidolyth-Launcher"
  }
}
